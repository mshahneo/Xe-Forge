// Stage-1 transform library for a BATCHED matmul (linalg.batch_matmul).
// Rendered from a lowering config, mirroring tile_vectorize.mlir.j2 but for the
// batched case: one batch per workgroup, then reduce each batch to the plain 2D
// matmul path.
//
// Recipe (differences from the plain-matmul template called out):
//   - tile_using_forall [1, wg_m, wg_n]  -> one batch per workgroup
//     (grid = [batch, M/wg_m, N/wg_n])
//   - fuse the zero-fill into the WG tile
//   - "test-linalg-rank-reduce-contraction-ops" collapses the batch=1 matmul to a
//     2-D linalg.matmul (via collapse_shape on the operands) so it becomes a clean
//     2-D vector.contract -> xegpu.dpas, exactly like the plain path. Run this
//     (+canonicalize) BEFORE k-tiling so the k-loop carries a 2-D accumulator; the
//     zero-fill then folds to a vector<wg_m x wg_n> iter_arg (see ORDERING note in
//     the body). Tiling k on the 4-D op first breaks the fold on non-square shapes.
//   - tile_using_for [0, 0, k_tile] on the resulting 2-D linalg.matmul -> k-loop.
//   - vectorize (folding f16->f32 extf into the mixed-precision contract).
//   - CAST AWAY LEADING UNIT DIMS: the fused fill stays rank-3
//     (vector<1 x wg_m x wg_n>) after rank-reduction and would lower to a *scatter*
//     xegpu.store with no layout attr -> segfaults gpu-lower-to-xevm
//     (XeGPUPropagateLayout / inferMaskOffsetLayoutForScatterIO on a null layout).
//     cast_away_vector_leading_one_dim + drop_unit_dims_with_shape_cast rewrite
//     those rank-3 transfers into clean 2-D block transfers. THIS is the fix that
//     makes the batched path lower without crashing.
//   - then the same hoist/canonicalize/bufferize/forall->gpu/launch-threads tail.
module attributes {transform.with_named_sequence} {
  transform.named_sequence @__transform_main(%root: !transform.any_op) {
    %mm = transform.structured.match ops{["linalg.batch_matmul"]} in %root : (!transform.any_op) -> !transform.any_op
    %fill = transform.structured.match ops{["linalg.fill"]} in %root : (!transform.any_op) -> !transform.any_op
    // One batch per workgroup: batch tile 1, WG tile [wg_m, wg_n].
    %t, %fa = transform.structured.tile_using_forall %mm tile_sizes [1, {{ wg_m }}, {{ wg_n }}] : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %ff, %nc = transform.structured.fuse_into_containing_op %fill into %fa : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    // Collapse the batch=1 matmul to a 2-D linalg.matmul (func-scoped pass) BEFORE
    // tiling k. Order matters: rank-reducing first means the k-loop is built around
    // a 2-D accumulator, so loop-invariant-subset-hoisting folds the zero-fill into
    // a vector iter_arg (arith.constant dense<0.0>) exactly like the plain-matmul
    // path. If k is tiled first (on the 4-D op), the loop carries a 1 x wg_m x wg_n
    // accumulator with a collapse_shape inside; hoisting can't fold through the
    // reshape, leaving a dynamic-stride accumulator transfer_read that
    // convert-vector-to-xegpu rejects on non-square/partial-tile shapes.
    %frr = transform.structured.match ops{["func.func"]} in %root : (!transform.any_op) -> !transform.any_op
    %rr = transform.apply_registered_pass "test-linalg-rank-reduce-contraction-ops" to %frr : (!transform.any_op) -> !transform.any_op
    %fcan = transform.structured.match ops{["func.func"]} in %root : (!transform.any_op) -> !transform.any_op
    %cann = transform.apply_registered_pass "canonicalize" to %fcan : (!transform.any_op) -> !transform.any_op
    // K-loop tile on the now-2-D matmul (iteration space m, n, k -> [0, 0, k_tile]).
    %mm2 = transform.structured.match ops{["linalg.matmul"]} in %root : (!transform.any_op) -> !transform.any_op
    %tk, %kl = transform.structured.tile_using_for %mm2 tile_sizes [0, 0, {{ k_tile }}] : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
{% if cast_ab %}    // f32->f16 A/B cast: fuse the truncf-cast producers into the k-loop (XeGPU
    // requires f16 A/B; C stays f32).
    %casta = transform.get_producer_of_operand %tk[0] : (!transform.any_op) -> !transform.any_op
    %fca, %fcal = transform.structured.fuse_into_containing_op %casta into %kl : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
    %castb = transform.get_producer_of_operand %tk[1] : (!transform.any_op) -> !transform.any_op
    %fcb, %fcbl = transform.structured.fuse_into_containing_op %castb into %kl : (!transform.any_op, !transform.any_op) -> (!transform.any_op, !transform.any_op)
{% endif %}    %f = transform.structured.match ops{["func.func"]} in %root : (!transform.any_op) -> !transform.any_op
    %v = transform.structured.vectorize_children_and_apply_patterns %f {fold_type_extensions_into_contract} : (!transform.any_op) -> !transform.any_op
    // Strip leading unit dims so the fused fill's vector<1 x wg_m x wg_n> write
    // becomes a 2-D block transfer (not a scatter store) -> avoids the WG-lowering
    // segfault. This is the batched-path-specific fix.
    %fc = transform.structured.match ops{["func.func"]} in %root : (!transform.any_op) -> !transform.any_op
    transform.apply_patterns to %fc {
      transform.apply_patterns.vector.cast_away_vector_leading_one_dim
      transform.apply_patterns.vector.drop_unit_dims_with_shape_cast
    } : !transform.any_op
    // Promote accumulator to a zero-initialized vector iter_arg (hoist + fold).
    %fh = transform.structured.match ops{["func.func"]} in %root : (!transform.any_op) -> !transform.any_op
    %h1 = transform.apply_registered_pass "loop-invariant-subset-hoisting" to %fh : (!transform.any_op) -> !transform.any_op
    %h2 = transform.apply_registered_pass "canonicalize" to %h1 : (!transform.any_op) -> !transform.any_op
    %bmod = transform.bufferization.one_shot_bufferize %root {function_boundary_type_conversion = 1 : i32, bufferize_function_boundaries = true} : (!transform.any_op) -> !transform.any_op
    %fa2 = transform.structured.match ops{["scf.forall"]} in %bmod : (!transform.any_op) -> !transform.any_op
    %par = transform.loop.forall_to_parallel %fa2 : (!transform.any_op) -> !transform.any_op
    %f2 = transform.structured.match ops{["func.func"]} in %bmod : (!transform.any_op) -> !transform.any_op
    %g1 = transform.apply_registered_pass "gpu-map-parallel-loops" to %f2 : (!transform.any_op) -> !transform.any_op
    %g2 = transform.apply_registered_pass "convert-parallel-loops-to-gpu" to %g1 : (!transform.any_op) -> !transform.any_op
    %g3 = transform.apply_registered_pass "gpu-launch-sink-index-computations" to %g2 : (!transform.any_op) -> !transform.any_op
    %launch = transform.structured.match ops{["gpu.launch"]} in %g3 : (!transform.any_op) -> !transform.any_op
    transform.xegpu.set_gpu_launch_threads %launch threads = [{{ nb_threads }}, 1, 1] : !transform.any_op
    transform.yield
  }
}
